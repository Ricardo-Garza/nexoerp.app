# ============================================================
# Nexo ERP — variables de entorno (nombres; nunca commitear valores)
# ============================================================

# --- Firebase (módulos legacy: auth, CRM, ventas, bancos, etc.) ---
# Requeridas en producción/preview (proyecto autorizado: nexoerp-88c6e). Si faltan, la pantalla de
# acceso muestra un error de configuración: ya NO se cae a modo demo. Ver docs/AUTH_AND_TENANCY.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- White-label (opcionales; defaults: Nexo ERP / tenant DELAR Foods) ---
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_SHORT_NAME=
NEXT_PUBLIC_APP_TAGLINE=

# --- Modo de autenticación ---
# "demo" SOLO para desarrollo local o un entorno aislado declarado. Se ignora (error de configuración)
# en producción de Vercel. Fuera de `next dev` exige además NEXT_PUBLIC_DEMO_ISOLATED=true.
# NEXT_PUBLIC_AUTH_MODE=demo
# NEXT_PUBLIC_DEMO_ISOLATED=true

# --- Nexo Intelligence (opcional) ---
# COPILOT_DEMO_DISABLED=true   # apaga el copiloto de demostración en este entorno

# --- CRM Momentum (server-side; sandbox si está vacía) ---
# MOMENTUM_BASE_URL=https://crm-staging.example.com

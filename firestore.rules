rules_version = '2';

// =====================================================================================
// NexoERP — Firestore Security Rules (aislamiento multiempresa)
//
// Principios:
//  1. Identidad de plataforma SOLO por custom claim firmado (`platformAdmin == true`),
//     asignado con Firebase Admin SDK. Un correo en el token NO concede nada.
//  2. Empresa (tenant) del usuario: claim `companyId`/`tenantId` y, si no hay claim, su perfil
//     `users/{uid}.companyId`. El perfil NO es editable por el propio usuario (sin escalamiento).
//  3. Cada colección de negocio se aísla por `companyId` (o por autoría `userId`); ya no existe
//     el comodín «cualquier autenticado lee todo».
//  4. Todo lo demás está denegado.
//
// Probado con el emulador: tests/rules/firestore.rules.test.ts  (npm run test:rules)
// =====================================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identidad ----------
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Administrador global: SOLO por custom claim (nunca por correo ni por campos del perfil).
    function isPlatformAdmin() {
      return signedIn() && request.auth.token.get('platformAdmin', false) == true;
    }

    // Soporte de plataforma: solo lectura de empresas y tickets.
    function isPlatformStaff() {
      return isPlatformAdmin() || (signedIn() && request.auth.token.get('platformSupport', false) == true);
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function claimTenant() {
      return request.auth.token.get('companyId', request.auth.token.get('tenantId', null));
    }

    // Empresa del usuario: claim firmado primero; perfil como respaldo (el usuario no puede editarlo).
    function myTenant() {
      return claimTenant() != null ? claimTenant() : (hasProfile() ? profile().get('companyId', null) : null);
    }

    function isMember(tenantId) {
      return signedIn() && tenantId != null && myTenant() == tenantId;
    }

    function myTenantRole() {
      return request.auth.token.get('tenantRole', hasProfile() ? profile().get('role', 'user') : 'user');
    }

    function isTenantAdmin(tenantId) {
      return isMember(tenantId) && myTenantRole() == 'admin';
    }

    function canAccessTenant(tenantId) {
      return isPlatformAdmin() || isMember(tenantId);
    }

    function canAdminTenant(tenantId) {
      return isPlatformAdmin() || isTenantAdmin(tenantId);
    }

    // Por omisión todo denegado.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Usuarios ----------
    // Campos que el propio usuario puede cambiar en su perfil (nunca role, companyId ni claims).
    function selfEditableKeys() {
      return ['name', 'displayName', 'phone', 'photoURL', 'language', 'updatedAt', 'lastLoginAt'];
    }

    // Campos que un administrador de empresa puede cambiar a miembros de SU empresa.
    function tenantAdminEditableKeys() {
      return ['name', 'displayName', 'phone', 'role', 'disabled', 'updatedAt'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        uid() == userId ||
        isPlatformAdmin() ||
        (resource != null && resource.data.get('companyId', null) != null && resource.data.companyId == myTenant())
      );

      // Auto-alta SIN privilegios: rol «user», sin empresa ni campos de plataforma. La empresa y
      // los roles los asigna un administrador (Admin SDK / plataforma).
      allow create: if signedIn() && (
        isPlatformAdmin() ||
        (
          uid() == userId &&
          request.resource.data.keys().hasOnly(['email', 'name', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
          request.resource.data.get('role', 'user') == 'user' &&
          request.resource.data.get('email', request.auth.token.get('email', null)) == request.auth.token.get('email', null)
        )
      );

      allow update: if signedIn() && (
        isPlatformAdmin() ||
        (
          uid() == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(selfEditableKeys())
        ) ||
        (
          uid() != userId &&
          isTenantAdmin(resource.data.get('companyId', null)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(tenantAdminEditableKeys()) &&
          request.resource.data.get('role', 'user') in ['user', 'admin']
        )
      );

      allow delete: if signedIn() && (
        isPlatformAdmin() ||
        (uid() != userId && isTenantAdmin(resource.data.get('companyId', null)))
      );

      match /preferences/{prefId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // ---------- Control Plane: empresas (tenants) ----------
    match /tenants/{tenantId} {
      allow read: if canAccessTenant(tenantId) || isPlatformStaff();
      allow create, delete: if isPlatformAdmin();
      // El administrador de la empresa solo ajusta apariencia/documentos; módulos y versión son de plataforma.
      allow update: if isPlatformAdmin() || (
        isTenantAdmin(tenantId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ui', 'branding', 'documents', 'updatedAt'])
      );

      // Auditoría: se agrega, nunca se edita ni se borra; la lee el admin de la empresa o la plataforma.
      match /auditEvents/{eventId} {
        allow read: if canAdminTenant(tenantId) || isPlatformStaff();
        allow create: if canAccessTenant(tenantId) && request.resource.data.get('tenantId', tenantId) == tenantId;
        allow update, delete: if false;
      }

      match /imports/{importId} {
        allow read: if canAccessTenant(tenantId);
        allow create: if canAccessTenant(tenantId) && request.resource.data.get('tenantId', tenantId) == tenantId;
        allow update, delete: if false;
      }

      // Datos de negocio aislados por empresa. Ningún usuario de otra empresa los ve ni los escribe.
      match /{collectionId}/{docId=**} {
        allow read: if !(collectionId in ['auditEvents', 'imports']) && canAccessTenant(tenantId);
        allow create, update: if !(collectionId in ['auditEvents', 'imports']) && canAccessTenant(tenantId) &&
          request.resource.data.get('tenantId', tenantId) == tenantId;
        allow delete: if !(collectionId in ['auditEvents', 'imports']) && canAccessTenant(tenantId);
      }
    }

    // ---------- Plataforma ----------
    match /platform_support/{ticketId} {
      // Crear un ticket: autenticado y, si indica empresa, perteneciente a ella.
      allow create: if signedIn() && (
        request.resource.data.get('tenantId', null) == null ||
        canAccessTenant(request.resource.data.tenantId)
      );
      allow read: if isPlatformStaff();
      allow update, delete: if isPlatformAdmin();
    }

    match /platform_meta/{docId} {
      allow read: if signedIn();
      allow write: if isPlatformAdmin();
    }

    // Bitácora de acciones administrativas de plataforma (p. ej. asignación de claims). Solo se agrega.
    match /platform_audit/{entryId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin() && request.resource.data.get('actorUid', null) == uid();
      allow update, delete: if false;
    }

    // Solicitudes de demo desde la landing (creación pública acotada); las gestiona la plataforma.
    match /demo_requests/{requestId} {
      allow create: if request.resource.data.keys().size() <= 20;
      allow read, update, delete: if isPlatformAdmin();
    }

    // ---------- Empresas (legado) ----------
    match /companies/{companyId} {
      allow read: if signedIn() && (
        isPlatformAdmin() ||
        resource.data.get('userId', null) == uid() ||
        companyId == myTenant() ||
        companyId == uid()
      );
      allow create: if signedIn() && (
        isPlatformAdmin() ||
        (request.resource.data.get('userId', null) == uid() && (companyId == uid() || companyId == myTenant()))
      );
      allow update, delete: if signedIn() && (
        isPlatformAdmin() ||
        ((resource.data.get('userId', null) == uid() || isTenantAdmin(companyId)) &&
          request.resource.data.get('userId', null) == resource.data.get('userId', null))
      );
    }

    // ---------- Colecciones de negocio (legado): clientes, productos, pedidos, facturas, inventario, ... ----------
    // Cada documento pertenece a una empresa (`companyId`) y/o a su autor (`userId`).
    // Reemplaza el comodín que dejaba leer TODO a cualquier usuario autenticado.
    function isReservedCollection(name) {
      return name in ['users', 'tenants', 'companies', 'platform_support', 'platform_meta', 'platform_audit', 'demo_requests'];
    }

    function docTenant(data) {
      return data.get('companyId', null);
    }

    function canReadDoc(data) {
      return isPlatformAdmin() ||
        data.get('userId', null) == uid() ||
        (docTenant(data) != null && (isMember(docTenant(data)) || docTenant(data) == uid()));
    }

    match /{collection}/{docId} {
      allow read: if !isReservedCollection(collection) && signedIn() && canReadDoc(resource.data);

      // Alta: como autor y dentro de la propia empresa (o sin empresa, cuenta unipersonal).
      allow create: if !isReservedCollection(collection) && signedIn() && (
        isPlatformAdmin() ||
        (
          request.resource.data.get('userId', null) == uid() &&
          (
            docTenant(request.resource.data) == null ||
            docTenant(request.resource.data) == uid() ||
            isMember(docTenant(request.resource.data))
          )
        )
      );

      // Edición: el autor o el administrador de la empresa; el documento no cambia de empresa ni de autor.
      allow update: if !isReservedCollection(collection) && signedIn() && (
        isPlatformAdmin() ||
        (
          (resource.data.get('userId', null) == uid() || isTenantAdmin(docTenant(resource.data))) &&
          docTenant(request.resource.data) == docTenant(resource.data) &&
          request.resource.data.get('userId', null) == resource.data.get('userId', null)
        )
      );

      allow delete: if !isReservedCollection(collection) && signedIn() && (
        isPlatformAdmin() ||
        resource.data.get('userId', null) == uid() ||
        isTenantAdmin(docTenant(resource.data))
      );
    }
  }
}
